# Postgres connection string. On Vercel, create a Postgres database (Vercel Postgres,
# Neon, or Supabase) and paste the connection string it gives you here / into your
# Vercel project's Environment Variables.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Optional: a separate direct (non-pooled) connection string, required by some
# providers (e.g. Neon, Supabase) for running Prisma migrations.
# DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"
